@model List<JewelleryCommerce.Web.Models.Entities.Product>
@{
    ViewData["Title"] = "Products";
    var statusFilter = ViewBag.StatusFilter as string;
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card stat-card">
    <div class="card-header bg-white d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div class="d-flex gap-2">
            <a href="/Admin/Products" class="btn btn-sm @(string.IsNullOrEmpty(statusFilter) ? "btn-gold" : "btn-outline-secondary")">
                All (@Model.Count)
            </a>
            <a href="/Admin/Products?status=Pending" class="btn btn-sm @(statusFilter == "Pending" ? "btn-gold" : "btn-outline-secondary")">
                Pending Approval
            </a>
        </div>
        <span class="text-muted small">@Model.Count products</span>
    </div>
    <div class="card-body p-0">
        <table class="table table-clean mb-0">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>Vendor</th>
                    <th>Category</th>
                    <th>Price</th>
                    <th>Stock</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var p in Model)
                    {
                        var img = p.Images.FirstOrDefault(i => i.IsPrimary)?.ImageUrl
                        ?? p.Images.FirstOrDefault()?.ImageUrl
                        ?? "https://via.placeholder.com/60";

                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <img src="@img" style="width: 50px; height: 50px; object-fit: cover;"
                                         class="rounded" />
                                    <div>
                                        <div class="fw-semibold">@p.Title</div>
                                        <small class="text-muted">@p.Purity · @p.Weight g</small>
                                    </div>
                                </div>
                            </td>
                            <td>@p.Vendor.ShopName</td>
                            <td>@p.Category.Name</td>
                            <td class="fw-bold">₹ @p.Price.ToString("N0")</td>
                            <td>@p.Stock</td>
                            <td>
                                @if (p.IsApproved)
                                {
                                    <span class="badge bg-success">Approved</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">Pending</span>
                                }
                                @if (!p.IsActive)
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </td>
                            <td class="text-end">
                                @if (!p.IsApproved)
                                {
                                    <form method="post" asp-action="Approve" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@p.Id" />
                                        <button class="btn btn-sm btn-success">
                                            <i class="bi bi-check"></i> Approve
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <form method="post" asp-action="Reject" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@p.Id" />
                                        <button class="btn btn-sm btn-outline-warning">
                                            <i class="bi bi-x"></i> Un-approve
                                        </button>
                                    </form>
                                }

                                <form method="post" asp-action="ToggleActive" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@p.Id" />
                                    <button class="btn btn-sm btn-outline-secondary">
                                        <i class="bi bi-power"></i>
                                    </button>
                                </form>

                                <form method="post" asp-action="Delete" class="d-inline"
                                      onsubmit="return confirm('Delete this product?')">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@p.Id" />
                                    <button class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">No products found</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>