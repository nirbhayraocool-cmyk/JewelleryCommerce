@if (TempData["Error"] != null)
{
    <div class="alert alert-danger"><strong>ERROR:</strong> @TempData["Error"]</div>
}
@model List<JewelleryCommerce.Web.Models.Entities.Product>
@{
    ViewData["Title"] = "My Products";
    var vendor = ViewBag.Vendor as JewelleryCommerce.Web.Models.Entities.Vendor;
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div class="text-muted small">@Model.Count products · Commission: @vendor?.CommissionRate%</div>
    <a href="/Vendor/Products/Create" class="btn btn-gold">
        <i class="bi bi-plus-circle"></i> Add Product
    </a>
</div>

<div class="card stat-card">
    <div class="card-body p-0">
        <table class="table table-clean mb-0">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>Category</th>
                    <th>Price</th>
                    <th>Your Earning</th>
                    <th>Stock</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var p in Model)
                    {
                        var img = p.Images.FirstOrDefault(i => i.IsPrimary)?.ImageUrl
                        ?? p.Images.FirstOrDefault()?.ImageUrl
                        ?? "https://via.placeholder.com/50";
                        var earning = p.Price * (1 - (vendor?.CommissionRate ?? 10) / 100);

                        <tr>
                            <td>
                                <div class="d-flex gap-2 align-items-center">
                                    <img src="@img" style="width: 50px; height: 50px; object-fit: cover;"
                                         class="rounded" />
                                    <div>
                                        <div class="fw-semibold">@p.Title</div>
                                        <small class="text-muted">@p.Purity · @p.Weight g</small>
                                    </div>
                                </div>
                            </td>
                            <td>@p.Category.Name</td>
                            <td>₹ @p.Price.ToString("N0")</td>
                            <td class="text-success fw-bold">₹ @earning.ToString("N0")</td>
                            <td>@p.Stock</td>
                            <td>
                                @if (p.IsApproved)
                                {
                                    <span class="badge bg-success">Approved</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">Pending</span>
                                }
                                @if (!p.IsActive)
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </td>
                            <td class="text-end">
                                <a href="/Vendor/Products/Edit/@p.Id" class="btn btn-sm btn-outline-secondary">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form method="post" asp-action="Delete" class="d-inline"
                                      onsubmit="return confirm('Delete this product?')">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@p.Id" />
                                    <button class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-5">
                            <i class="bi bi-box" style="font-size: 3rem;"></i>
                            <p class="mt-2 mb-0">No products yet. Add your first product!</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>