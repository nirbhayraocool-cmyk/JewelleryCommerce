@model JewelleryCommerce.Web.Models.Entities.Product
@{
    ViewData["Title"] = "Edit Product";
    var categories = ViewBag.Categories as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
    var currentImage = Model.Images.FirstOrDefault(i => i.IsPrimary)?.ImageUrl
                       ?? Model.Images.FirstOrDefault()?.ImageUrl ?? "";
}

<a href="/Vendor/Products" class="btn btn-sm btn-outline-secondary mb-3">
    <i class="bi bi-arrow-left"></i> Back
</a>

<div class="alert alert-warning small">
    <i class="bi bi-exclamation-triangle"></i> Edit karne ke baad product admin ko dobara approval ke liye jaayega.
</div>

<div class="card stat-card">
    <div class="card-body">
        <form method="post" asp-action="Edit" asp-route-id="@Model.Id">
            @Html.AntiForgeryToken()

            <div class="row g-3">
                <div class="col-md-8">
                    <label class="form-label fw-semibold">Product Title</label>
                    <input asp-for="Title" class="form-control" required />
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-semibold">Category</label>
                    <select asp-for="CategoryId" asp-items="categories" class="form-select" required></select>
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-semibold">Metal Type</label>
                    <select asp-for="MetalType" class="form-select"
                            asp-items="Html.GetEnumSelectList<JewelleryCommerce.Web.Models.Entities.MetalType>()"></select>
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-semibold">Purity</label>
                    <input asp-for="Purity" class="form-control" />
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-semibold">Weight (g)</label>
                    <input asp-for="Weight" type="number" step="0.01" class="form-control" />
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-semibold">Price (₹)</label>
                    <input asp-for="Price" type="number" step="0.01" class="form-control" required />
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-semibold">MRP (₹)</label>
                    <input asp-for="Mrp" type="number" step="0.01" class="form-control" />
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-semibold">Stock</label>
                    <input asp-for="Stock" type="number" class="form-control" required />
                </div>

                <div class="col-12">
                    <label class="form-label fw-semibold">Image URL</label>
                    @if (!string.IsNullOrEmpty(currentImage))
                    {
                        <div class="mb-2">
                            <img src="@currentImage" style="height: 80px;" class="rounded border" />
                        </div>
                    }
                    <input name="ImageUrl" class="form-control" value="@currentImage" />
                </div>

                <div class="col-12">
                    <label class="form-label fw-semibold">Description</label>
                    <textarea asp-for="Description" rows="4" class="form-control"></textarea>
                </div>

                <div class="col-12 text-end">
                    <a href="/Vendor/Products" class="btn btn-outline-secondary">Cancel</a>
                    <button class="btn btn-gold">
                        <i class="bi bi-check"></i> Save & Re-submit
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>