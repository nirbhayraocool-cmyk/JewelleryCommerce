@model JewelleryCommerce.Web.Models.Entities.Product
@{
    ViewData["Title"] = "Add Product";
    var categories = ViewBag.Categories as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
}

<a href="/Vendor/Products" class="btn btn-sm btn-outline-secondary mb-3">
    <i class="bi bi-arrow-left"></i> Back
</a>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger"><strong>ERROR:</strong> @TempData["Error"]</div>
}

<div class="card">
    <div class="card-body">
        <form method="post" asp-action="Create">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="alert alert-danger"></div>

            <div class="row g-3">
                <div class="col-md-8">
                    <label class="form-label fw-bold">Product Title *</label>
                    <input asp-for="Title" class="form-control" required />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold">Category *</label>
                    <select asp-for="CategoryId" asp-items="categories" class="form-select" required>
                        <option value="">-- Select --</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold">Metal Type</label>
                    <select asp-for="MetalType" class="form-select"
                            asp-items="Html.GetEnumSelectList<JewelleryCommerce.Web.Models.Entities.MetalType>()"></select>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold">Purity</label>
                    <input asp-for="Purity" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold">Weight (g)</label>
                    <input asp-for="Weight" type="number" step="0.01" class="form-control" required />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold">Price (₹) *</label>
                    <input asp-for="Price" type="number" step="0.01" class="form-control" required />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold">MRP (₹)</label>
                    <input asp-for="Mrp" type="number" step="0.01" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold">Stock *</label>
                    <input name="Stock" type="number" value="10" class="form-control" required />
                </div>
                <div class="col-12">
                    <label class="form-label fw-bold">Image URL</label>
                    <input name="ImageUrl" class="form-control" placeholder="https://..." />
                </div>
                <div class="col-12">
                    <label class="form-label fw-bold">Description</label>
                    <textarea asp-for="Description" rows="3" class="form-control"></textarea>
                </div>
                <div class="col-12 text-end">
                    <button class="btn btn-warning">Submit for Approval</button>
                </div>
            </div>
        </form>
    </div>
</div>