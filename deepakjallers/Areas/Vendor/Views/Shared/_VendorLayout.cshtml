<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Vendor</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body {
            background: #f5f6fa;
        }

        .vendor-sidebar {
            width: 240px;
            min-height: 100vh;
            background: linear-gradient(180deg, #1a1a1a 0%, #2a2018 100%);
            color: #ccc;
            position: fixed;
            left: 0;
            top: 0;
            z-index: 1000;
        }

            .vendor-sidebar .brand {
                padding: 1rem;
                font-family: Georgia, serif;
                font-weight: 700;
                color: #fff;
                font-size: 1.2rem;
                border-bottom: 1px solid #2a2a2a;
            }

            .vendor-sidebar a.nav-link {
                color: #bbb;
                padding: .65rem 1rem;
                border-left: 3px solid transparent;
                font-size: .92rem;
            }

                .vendor-sidebar a.nav-link:hover {
                    background: #252525;
                    color: #fff;
                }

                .vendor-sidebar a.nav-link.active {
                    color: #fff;
                    background: #252525;
                    border-left-color: var(--gold);
                }

        .vendor-content {
            margin-left: 240px;
            padding: 1.5rem 2rem;
        }

        .admin-topbar {
            background: #fff;
            border-radius: 8px;
            padding: .75rem 1rem;
            margin-bottom: 1.5rem;
            box-shadow: 0 1px 3px rgba(0,0,0,.05);
        }

        .stat-card {
            border-radius: 10px;
            border: 0;
            box-shadow: 0 2px 8px rgba(0,0,0,.05);
        }

            .stat-card .icon {
                width: 50px;
                height: 50px;
                border-radius: 10px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 1.5rem;
            }

        .table-clean th {
            font-size: .8rem;
            text-transform: uppercase;
            color: #888;
            font-weight: 600;
            border-bottom: 2px solid #eee;
        }

        .table-clean td {
            vertical-align: middle;
            font-size: .92rem;
        }

        @@media (max-width: 768px) {
            .vendor-sidebar {
                transform: translateX(-100%);
                transition: .3s;
            }

                .vendor-sidebar.show {
                    transform: translateX(0);
                }

            .vendor-content {
                margin-left: 0;
                padding: 1rem;
            }
        }
    </style>
</head>
<body>

    <aside class="vendor-sidebar" id="vendorSidebar">
        <div class="brand"><span class="text-gold">◆</span> Vendor Panel</div>
        <nav class="nav flex-column py-2">
            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")"
               href="/Vendor/Dashboard">
                <i class="bi bi-speedometer2"></i> Dashboard
            </a>
            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Products" ? "active" : "")"
               href="/Vendor/Products">
                <i class="bi bi-box-seam"></i> My Products
            </a>
            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Orders" ? "active" : "")"
               href="/Vendor/Orders">
                <i class="bi bi-receipt"></i> Orders
            </a>
            <hr class="border-secondary mx-3" />
            <a class="nav-link" href="/" target="_blank">
                <i class="bi bi-shop-window"></i> View Store
            </a>
            <form method="post" action="/Account/Logout" class="px-3 py-2">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-sm btn-outline-danger w-100">
                    <i class="bi bi-box-arrow-right"></i> Logout
                </button>
            </form>
        </nav>
    </aside>

    <div class="vendor-content">
        <div class="admin-topbar d-flex justify-content-between align-items-center">
            <button class="btn btn-sm btn-outline-secondary d-md-none"
                    onclick="document.getElementById('vendorSidebar').classList.toggle('show')">
                <i class="bi bi-list"></i>
            </button>
            <h5 class="mb-0 fw-bold" style="font-family: Georgia, serif;">@ViewData["Title"]</h5>
            <div class="small text-muted">
                <i class="bi bi-shop"></i> @User.Identity?.Name
            </div>
        </div>

        @RenderBody()
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>