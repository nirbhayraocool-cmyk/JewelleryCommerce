@model JewelleryCommerce.Web.Models.ViewModels.ProductDetailViewModel
@{
    ViewData["Title"] = Model.Title;
}

<!-- Breadcrumb -->
<div class="bg-cream py-3 border-bottom">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item">
                    <a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">Home</a>
                </li>
                <li class="breadcrumb-item">
                    <a asp-controller="Shop" asp-action="Index" class="text-decoration-none text-muted">Shop</a>
                </li>
                <li class="breadcrumb-item">
                    <a asp-controller="Shop" asp-action="Index" asp-route-cat="@Model.CategorySlug"
                       class="text-decoration-none text-muted">@Model.CategoryName</a>
                </li>
                <li class="breadcrumb-item active text-gold" aria-current="page">@Model.Title</li>
            </ol>
        </nav>
    </div>
</div>

<div class="container py-4 py-lg-5">

    <!-- ============ TOP: GALLERY + INFO ============ -->
    <div class="row g-4">

        <!-- GALLERY -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm">
                <div class="position-relative">
                    @if (Model.DiscountPercent > 0)
                    {
                        <span class="badge bg-danger position-absolute top-0 start-0 m-3 fs-6">
                            @Model.DiscountPercent% OFF
                        </span>
                    }
                    <button class="btn btn-light btn-sm rounded-circle position-absolute top-0 end-0 m-3"
                            title="Add to Wishlist">
                        <i class="bi bi-heart"></i>
                    </button>
                    <img id="mainImage"
                         src="@(Model.Images.FirstOrDefault()?.ImageUrl ?? "https://via.placeholder.com/600")"
                         class="img-fluid w-100 rounded-top"
                         style="height: 500px; object-fit: cover;"
                         alt="@Model.Title" />
                </div>

                @if (Model.Images.Count > 1)
                {
                    <div class="d-flex gap-2 p-3 overflow-auto">
                        @foreach (var img in Model.Images)
                        {
                            <img src="@img.ImageUrl"
                                 class="rounded border"
                                 style="width: 80px; height: 80px; object-fit: cover; cursor: pointer;"
                                 onclick="document.getElementById('mainImage').src=this.src"
                                 alt="thumb" />
                        }
                    </div>
                }
            </div>

            <!-- Trust Badges -->
            <div class="row g-2 mt-3">
                <div class="col-4">
                    <div class="text-center p-2 border rounded">
                        <i class="bi bi-patch-check text-gold fs-5"></i>
                        <div class="small fw-semibold">Hallmarked</div>
                    </div>
                </div>
                <div class="col-4">
                    <div class="text-center p-2 border rounded">
                        <i class="bi bi-truck text-gold fs-5"></i>
                        <div class="small fw-semibold">Free Ship</div>
                    </div>
                </div>
                <div class="col-4">
                    <div class="text-center p-2 border rounded">
                        <i class="bi bi-arrow-repeat text-gold fs-5"></i>
                        <div class="small fw-semibold">15-Day Return</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- PRODUCT INFO -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm p-4 h-100">
                <small class="text-muted text-uppercase">
                    <i class="bi bi-shop"></i> @Model.VendorName
                </small>

                <h2 class="fw-bold mt-2 mb-3" style="font-family: Georgia, serif;">
                    @Model.Title
                </h2>

                <!-- Rating -->
                <div class="d-flex align-items-center gap-2 mb-3 flex-wrap">
                    <div>
                        @for (int i = 1; i <= 5; i++)
                        {
                            <i class="bi bi-star@(i <= Math.Round(Model.AverageRating) ? "-fill" : "") text-warning"></i>
                        }
                    </div>
                    <small class="text-muted">
                        @Model.AverageRating.ToString("0.0") (@Model.TotalReviews reviews)
                    </small>
                    <span class="badge bg-success-subtle text-success border border-success ms-2">
                        In Stock: @Model.Stock
                    </span>
                </div>

                <hr />

                <!-- Price -->
                <div class="mb-3">
                    <span class="display-6 fw-bold text-gold">₹ @Model.Price.ToString("N0")</span>
                    @if (Model.DiscountPercent > 0)
                    {
                        <span class="text-muted text-decoration-line-through ms-2 fs-5">
                            ₹ @Model.Mrp.ToString("N0")
                        </span>
                        <span class="badge bg-danger ms-2">@Model.DiscountPercent% OFF</span>
                    }
                    <div class="small text-muted mt-1">
                        Inclusive of all taxes · Making charges included
                    </div>
                </div>

                <hr />

                <!-- Specs -->
                <div class="row g-2 mb-3 small">
                    <div class="col-6">
                        <span class="text-muted">Metal:</span>
                        <strong class="ms-1">@Model.MetalType</strong>
                    </div>
                    <div class="col-6">
                        <span class="text-muted">Purity:</span>
                        <strong class="ms-1">@Model.Purity</strong>
                    </div>
                    <div class="col-6">
                        <span class="text-muted">Weight:</span>
                        <strong class="ms-1">@Model.Weight g</strong>
                    </div>
                    <div class="col-6">
                        <span class="text-muted">Category:</span>
                        <strong class="ms-1">@Model.CategoryName</strong>
                    </div>
                </div>

                <!-- Variants -->
                @if (Model.Variants.Any())
                {
                    <div class="mb-3">
                        <label class="fw-semibold mb-2">Choose Option:</label>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var v in Model.Variants)
                            {
                                <input type="radio" class="btn-check" name="variant"
                                       id="var_@v.Id" value="@v.Id"
                                       checked="@v.IsDefault" />
                                <label class="btn btn-outline-secondary btn-sm px-3" for="var_@v.Id">
                                    @v.Name
                                    @if (v.AdditionalPrice.HasValue && v.AdditionalPrice > 0)
                                    {
                                        <span class="text-gold">+₹@v.AdditionalPrice.Value.ToString("N0")</span>
                                    }
                                </label>
                            }
                        </div>
                    </div>
                }

                <!-- Quantity -->
                <div class="mb-3">
                    <label class="fw-semibold mb-2">Quantity:</label>
                    <div class="input-group" style="max-width: 150px;">
                        <button class="btn btn-outline-secondary" type="button" onclick="decQty()">−</button>
                        <input type="text" id="qty" class="form-control text-center" value="1" readonly />
                        <button class="btn btn-outline-secondary" type="button" onclick="incQty()">+</button>
                    </div>
                </div>

                <!-- CTAs -->
                <div class="d-flex gap-2 mb-3">
                    <button class="btn btn-gold btn-lg flex-grow-1" onclick="addToCart()">
                        <i class="bi bi-bag-plus"></i> Add to Cart
                    </button>
                    <button class="btn btn-outline-gold btn-lg flex-grow-1" onclick="buyNow()">
                        <i class="bi bi-lightning-charge"></i> Buy Now
                    </button>
                </div>

                <!-- Delivery Info -->
                <div class="alert alert-light border small mb-0">
                    <div><i class="bi bi-geo-alt text-gold"></i> Delivery in 5-7 business days</div>
                    <div class="mt-1"><i class="bi bi-cash-coin text-gold"></i> Cash on Delivery Available</div>
                    <div class="mt-1"><i class="bi bi-shield-check text-gold"></i> Fully Insured Shipping</div>
                </div>
            </div>
        </div>
    </div>

    <!-- ============ TABS ============ -->
    <div class="mt-5">
        <ul class="nav nav-tabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#desc" type="button" role="tab">
                    <i class="bi bi-info-circle"></i> Description
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#reviews" type="button" role="tab">
                    <i class="bi bi-chat-square-text"></i> Reviews (@Model.TotalReviews)
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#ship" type="button" role="tab">
                    <i class="bi bi-truck"></i> Shipping & Returns
                </button>
            </li>
        </ul>

        <div class="tab-content border border-top-0 p-4 bg-white rounded-bottom">

            <!-- DESCRIPTION -->
            <div class="tab-pane fade show active" id="desc" role="tabpanel">
                <h5 class="fw-bold mb-3" style="font-family: Georgia, serif;">About This Product</h5>
                <p class="text-muted">@Model.Description</p>

                <h6 class="fw-bold mt-4 mb-2">Specifications</h6>
                <table class="table table-sm table-bordered">
                    <tbody>
                        <tr><th width="200">Metal Type</th><td>@Model.MetalType</td></tr>
                        <tr><th>Purity</th><td>@Model.Purity</td></tr>
                        <tr><th>Weight</th><td>@Model.Weight g</td></tr>
                        <tr><th>Category</th><td>@Model.CategoryName</td></tr>
                        <tr><th>Sold By</th><td>@Model.VendorName</td></tr>
                        <tr><th>Certification</th><td>BIS Hallmarked</td></tr>
                    </tbody>
                </table>
            </div>

            <!-- REVIEWS -->
            <div class="tab-pane fade" id="reviews" role="tabpanel">
                <div class="row g-4">

                    <div class="col-md-4">
                        <div class="card bg-light border-0 p-3 text-center">
                            <div class="display-4 fw-bold text-gold">
                                @Model.AverageRating.ToString("0.0")
                            </div>
                            <div>
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <i class="bi bi-star@(i <= Math.Round(Model.AverageRating) ? "-fill" : "") text-warning"></i>
                                }
                            </div>
                            <small class="text-muted mt-1">
                                Based on @Model.TotalReviews reviews
                            </small>
                        </div>

                        <div class="mt-3">
                            @for (int s = 5; s >= 1; s--)
                            {
                                var count = Model.RatingBreakdown.ContainsKey(s) ? Model.RatingBreakdown[s] : 0;
                                var pct = Model.TotalReviews > 0 ? (count * 100 / Model.TotalReviews) : 0;
                                <div class="d-flex align-items-center mb-2 small">
                                    <span class="me-2">@s <i class="bi bi-star-fill text-warning"></i></span>
                                    <div class="progress flex-grow-1" style="height: 8px;">
                                        <div class="progress-bar bg-warning" style="width: @pct%"></div>
                                    </div>
                                    <span class="ms-2 text-muted">@count</span>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="col-md-8">
                        @if (Model.Reviews.Any())
                        {
                            @foreach (var r in Model.Reviews)
                            {
                                <div class="border-bottom pb-3 mb-3">
                                    <div class="d-flex justify-content-between">
                                        <div>
                                            <strong>@r.UserName</strong>
                                            @if (r.IsVerifiedPurchase)
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success ms-2 small">
                                                    <i class="bi bi-check-circle"></i> Verified
                                                </span>
                                            }
                                        </div>
                                        <small class="text-muted">@r.CreatedAt.ToString("dd MMM yyyy")</small>
                                    </div>
                                    <div class="mt-1">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            <i class="bi bi-star@(i <= r.Rating ? "-fill" : "") text-warning small"></i>
                                        }
                                    </div>
                                    @if (!string.IsNullOrEmpty(r.Title))
                                    {
                                        <h6 class="fw-bold mt-2 mb-1">@r.Title</h6>
                                    }
                                    <p class="text-muted mb-0 small">@r.Comment</p>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-center py-5 text-muted">
                                <i class="bi bi-chat-square-text" style="font-size: 3rem;"></i>
                                <p class="mt-2">No reviews yet.</p>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- SHIPPING -->
            <div class="tab-pane fade" id="ship" role="tabpanel">
                <h5 class="fw-bold mb-3" style="font-family: Georgia, serif;">Shipping & Returns</h5>
                <ul class="text-muted">
                    <li>Free shipping on orders above ₹5,000</li>
                    <li>Standard delivery: 5-7 business days across India</li>
                    <li>Fully insured shipping — 100% loss/damage coverage</li>
                    <li>Cash on Delivery available on all pincodes</li>
                    <li>15-day easy return policy</li>
                    <li>Hallmark certificate included with every purchase</li>
                </ul>
            </div>
        </div>
    </div>

    <!-- ============ RELATED PRODUCTS ============ -->
    @if (Model.RelatedProducts.Any())
    {
        <div class="mt-5">
            <h3 class="fw-bold mb-4" style="font-family: Georgia, serif;">You May Also Like</h3>
            <div class="row g-4">
                @foreach (var p in Model.RelatedProducts)
                {
                    <div class="col-xl-3 col-md-6">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="position-relative overflow-hidden">
                                @if (p.IsBestseller)
                                {
                                    <span class="badge badge-gold position-absolute top-0 start-0 m-2">BESTSELLER</span>
                                }
                                <a asp-controller="Product" asp-action="Details" asp-route-slug="@p.Slug">
                                    <img src="@p.ImageUrl" class="card-img-top product-img" alt="@p.Title" />
                                </a>
                            </div>
                            <div class="card-body d-flex flex-column">
                                <small class="text-muted text-uppercase" style="font-size: 0.7rem;">@p.VendorName</small>
                                <h6 class="fw-bold mt-1 mb-2" style="font-family: Georgia, serif;">
                                    <a asp-controller="Product" asp-action="Details" asp-route-slug="@p.Slug"
                                       class="text-dark text-decoration-none">@p.Title</a>
                                </h6>
                                <div class="mb-1">
                                    <span class="text-gold fw-bold fs-5">₹ @p.Price.ToString("N0")</span>
                                </div>
                                <div class="text-muted small mb-2">
                                    <i class="bi bi-star-fill text-warning"></i> @p.Rating.ToString("0.0")
                                    · @p.Weight g · @p.Purity
                                </div>
                                <button class="btn btn-gold w-100 mt-auto">
                                    <i class="bi bi-bag-plus"></i> Add to Cart
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        let qty = 1;
        const maxStock = @Model.Stock;

        function incQty() {
            if (qty < maxStock) {
                qty++;
                document.getElementById('qty').value = qty;
            }
        }
        function decQty() {
            if (qty > 1) {
                qty--;
                document.getElementById('qty').value = qty;
            }
        }
               function addToCart() {
            const variant = document.querySelector('input[name="variant"]:checked')?.value;
            const fd = new FormData();
            fd.append('productId', @Model.Id);
            fd.append('quantity', qty);
            if (variant) fd.append('variantId', variant);

            fetch('/Cart/Add', { method: 'POST', body: fd })
                .then(r => r.json())
                .then(d => {
                    if (d.success) {
                        // Update badge
                        const badge = document.getElementById('cartBadge');
                        if (badge) badge.textContent = d.totalItems;
                        // Sweet feedback
                        alert('✓ Added to cart!');
                    } else {
                        alert(d.message || 'Could not add to cart');
                    }
                })
                .catch(() => alert('Error adding to cart'));
        }

        function buyNow() {
            const variant = document.querySelector('input[name="variant"]:checked')?.value;
            const fd = new FormData();
            fd.append('productId', @Model.Id);
            fd.append('quantity', qty);
            if (variant) fd.append('variantId', variant);

            fetch('/Cart/Add', { method: 'POST', body: fd })
                .then(r => r.json())
                .then(d => {
                    if (d.success) window.location.href = '/Cart';
                    else alert(d.message || 'Error');
                })
                .catch(() => alert('Error'));
        }
       
    </script>
}