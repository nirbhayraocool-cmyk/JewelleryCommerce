<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Deepak Jewellers</title>
    <link href="~/style.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />


</head>
<body class="d-flex flex-column min-vh-100">
    <script>

        document.addEventListener('DOMContentLoaded', function () {
            fetch('/Cart/Count')
                .then(r => r.json())
                .then(d => {
                    const badge = document.getElementById('cartBadge');
                    if (badge) badge.textContent = d.count;
                })
                .catch(() => {});
        });
    </script>
    <!-- Top Bar -->
    <div class="bg-dark text-warning text-center py-2 small">
        <div class="container">
            <i class="bi bi-truck"></i> Free Shipping Above ₹5,000
            <span class="mx-2">|</span>
            <i class="bi bi-cash-coin"></i> Cash on Delivery Available
            <span class="mx-2">|</span>
            <i class="bi bi-patch-check"></i> 100% Hallmarked Jewellery
        </div>
    </div>

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm sticky-top">
        <div class="container">
            <a class="navbar-brand fw-bold fs-3" asp-controller="Home" asp-action="Index" style="font-family: Georgia, serif;">
                <span class="text-gold">◆</span> Deepak<span class="text-gold">Jewellers</span>
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link fw-semibold" asp-controller="Home" asp-action="Index">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link fw-semibold" asp-controller="Shop" asp-action="Index" asp-route-cat="gold">Gold</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link fw-semibold" asp-controller="Shop" asp-action="Index" asp-route-cat="silver">Silver</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link fw-semibold" asp-controller="Shop" asp-action="Index" asp-route-cat="diamond">Diamond</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link fw-semibold" asp-controller="Home" asp-action="About">About</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link fw-semibold" asp-controller="Home" asp-action="Contact">Contact</a>
                    </li>
                </ul>

                <div class="d-flex align-items-center gap-3">
                    <a href="#" class="text-dark fs-5"><i class="bi bi-search"></i></a>
                    <a href="#" class="text-dark fs-5"><i class="bi bi-heart"></i></a>
                    <a asp-controller="Cart" asp-action="Index" class="text-dark fs-5 position-relative">
                        <i class="bi bi-bag"></i>
                        <span id="cartBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill badge-gold">
                            0
                        </span>
                    </a>
                    <div class="dropdown">
                        <a href="#" class="text-dark fs-5" data-bs-toggle="dropdown">
                            <i class="bi bi-person"></i>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow">
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <li>
                                    <span class="dropdown-item-text small">
                                        <i class="bi bi-person-circle text-gold"></i>
                                        <strong>@User.Identity.Name</strong>
                                    </span>
                                </li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Account" asp-action="Orders">
                                        <i class="bi bi-receipt"></i> My Orders
                                    </a>
                                </li>
                                @if (User.IsInRole("Admin"))
                                {
                                    <li>
                                        <a class="dropdown-item" href="/Admin/Dashboard">
                                            <i class="bi bi-speedometer2"></i> Admin Panel
                                        </a>
                                    </li>
                                }
                                @if (User.IsInRole("Vendor"))
                                {
                                    <li>
                                        <a class="dropdown-item" href="/Vendor/Dashboard">
                                            <i class="bi bi-shop"></i> Vendor Panel
                                        </a>
                                    </li>
                                }
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item text-danger">
                                            <i class="bi bi-box-arrow-right"></i> Logout
                                        </button>
                                    </form>
                                </li>
                            }
                            else
                            {
                                <li><a class="dropdown-item" asp-controller="Account" asp-action="Login">Login</a></li>
                                <li><a class="dropdown-item" asp-controller="Account" asp-action="Register">Register</a></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li><a class="dropdown-item" asp-controller="Account" asp-action="Login">My Orders</a></li>
                                <li><a class="dropdown-item" asp-controller="Account" asp-action="Register">Become a Seller</a></li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="flex-grow-1">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="bg-dark text-white pt-5 pb-3 mt-5">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4 col-md-6">
                    <h5 class="fw-bold mb-3" style="font-family: Georgia, serif;">
                        <span class="text-gold">◆</span> Deepak<span class="text-gold">Jewellers</span>
                    </h5>
                    <p class="text-secondary small">
                        India's trusted multi-vendor jewellery marketplace. Gold, Silver aur Diamond —
                        sab certified sellers se ek hi jagah.
                    </p>
                    <div class="mt-3">
                        <a href="#" class="btn btn-sm btn-outline-light rounded-circle me-1"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="btn btn-sm btn-outline-light rounded-circle me-1"><i class="bi bi-instagram"></i></a>
                        <a href="#" class="btn btn-sm btn-outline-light rounded-circle me-1"><i class="bi bi-twitter-x"></i></a>
                        <a href="#" class="btn btn-sm btn-outline-light rounded-circle"><i class="bi bi-youtube"></i></a>
                    </div>
                </div>

                <div class="col-lg-2 col-md-6">
                    <h6 class="text-white text-uppercase small fw-bold mb-3">Shop</h6>
                    <ul class="list-unstyled">
                        <li class="mb-2"><a href="#" class="footer-link small">Gold Jewellery</a></li>
                        <li class="mb-2"><a href="#" class="footer-link small">Silver Jewellery</a></li>
                        <li class="mb-2"><a href="#" class="footer-link small">Diamond</a></li>
                        <li class="mb-2"><a href="#" class="footer-link small">New Arrivals</a></li>
                    </ul>
                </div>

                <div class="col-lg-2 col-md-6">
                    <h6 class="text-white text-uppercase small fw-bold mb-3">Help</h6>
                    <ul class="list-unstyled">
                        <li class="mb-2"><a href="#" class="footer-link small">Track Order</a></li>
                        <li class="mb-2"><a href="#" class="footer-link small">Return Policy</a></li>
                        <li class="mb-2"><a href="#" class="footer-link small">Shipping</a></li>
                        <li class="mb-2"><a href="#" class="footer-link small">Contact Us</a></li>
                    </ul>
                </div>

                <div class="col-lg-4 col-md-6">
                    <h6 class="text-white text-uppercase small fw-bold mb-3">Stay in Touch</h6>
                    <p class="text-secondary small mb-2">Get gold rate alerts & offers</p>
                    <div class="input-group">
                        <input type="email" class="form-control" placeholder="Your email" />
                        <button class="btn btn-gold">Subscribe</button>
                    </div>
                    <p class="text-secondary small mt-3 mb-0">
                        <i class="bi bi-telephone"></i> +91 98765 43210<br />
                        <i class="bi bi-envelope"></i> support@deepakjewellers.com
                    </p>
                </div>
            </div>

            <hr class="border-secondary my-4" />
            <div class="d-flex flex-wrap justify-content-between text-secondary small">
                <span>© @DateTime.Now.Year Deepak Jewellers. All rights reserved.</span>
                <span>Privacy Policy · Terms of Service</span>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>