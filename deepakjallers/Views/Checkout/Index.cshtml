@model JewelleryCommerce.Web.Models.ViewModels.CheckoutViewModel
@{
    ViewData["Title"] = "Checkout";
}

<div class="bg-cream py-3 border-bottom">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item">
                    <a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">Home</a>
                </li>
                <li class="breadcrumb-item">
                    <a asp-controller="Cart" asp-action="Index" class="text-decoration-none text-muted">Cart</a>
                </li>
                <li class="breadcrumb-item active text-gold">Checkout</li>
            </ol>
        </nav>
    </div>
</div>

<div class="container py-5">
    <h2 class="fw-bold mb-4" style="font-family: Georgia, serif;">
        <i class="bi bi-cash-coin text-gold"></i> Checkout
    </h2>

    <form asp-action="PlaceOrder" method="post">
        @Html.AntiForgeryToken()

        <div class="row g-4">

            <!-- LEFT: ADDRESS -->
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-body p-4">
                        <h5 class="fw-bold mb-3" style="font-family: Georgia, serif;">
                            <i class="bi bi-geo-alt text-gold"></i> Shipping Address
                        </h5>

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2"></div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Full Name</label>
                                <input asp-for="FullName" class="form-control" placeholder="Rahul Sharma" />
                                <span asp-validation-for="FullName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Phone</label>
                                <input asp-for="Phone" class="form-control" placeholder="9876543210" />
                                <span asp-validation-for="Phone" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold">Address</label>
                                <textarea asp-for="ShippingAddress" class="form-control" rows="2"
                                          placeholder="House no, street, landmark"></textarea>
                                <span asp-validation-for="ShippingAddress" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold">City</label>
                                <input asp-for="City" class="form-control" placeholder="Mumbai" />
                                <span asp-validation-for="City" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold">State</label>
                                <input asp-for="State" class="form-control" placeholder="Maharashtra" />
                                <span asp-validation-for="State" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold">Pincode</label>
                                <input asp-for="Pincode" class="form-control" placeholder="400001" />
                                <span asp-validation-for="Pincode" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- PAYMENT -->
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4">
                        <h5 class="fw-bold mb-3" style="font-family: Georgia, serif;">
                            <i class="bi bi-wallet2 text-gold"></i> Payment Method
                        </h5>

                        <div class="alert alert-success border-0 d-flex align-items-center mb-0">
                            <i class="bi bi-cash-coin fs-3 me-3"></i>
                            <div>
                                <strong>Cash on Delivery</strong><br />
                                <small>Pay when your order arrives. No advance payment needed.</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- RIGHT: SUMMARY -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4">
                        <h5 class="fw-bold mb-3" style="font-family: Georgia, serif;">Order Summary</h5>

                        <div class="mb-3">
                            @foreach (var item in Model.Cart.Items)
                            {
                                <div class="d-flex gap-2 mb-2 pb-2 border-bottom">
                                    <img src="@item.ImageUrl"
                                         style="width: 50px; height: 50px; object-fit: cover;"
                                         class="rounded" />
                                    <div class="flex-grow-1 small">
                                        <div class="fw-semibold">@item.Title</div>
                                        <small class="text-muted">
                                            @item.Quantity × ₹@item.Price.ToString("N0")
                                        </small>
                                    </div>
                                    <div class="small fw-bold">₹@item.LineTotal.ToString("N0")</div>
                                </div>
                            }
                        </div>

                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Subtotal</span>
                            <span>₹ @Model.Cart.Subtotal.ToString("N0")</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Shipping</span>
                            <span class="text-success">Free</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">COD Charges</span>
                            <span class="text-success">₹0</span>
                        </div>

                        <hr />

                        <div class="d-flex justify-content-between mb-3">
                            <strong>Total Payable</strong>
                            <strong class="text-gold fs-5">₹ @Model.Cart.Total.ToString("N0")</strong>
                        </div>

                        <button type="submit" class="btn btn-gold btn-lg w-100">
                            <i class="bi bi-check-circle"></i> Place Order (COD)
                        </button>

                        <div class="small text-muted text-center mt-2">
                            By placing order you agree to our Terms
                        </div>
                    </div>
                </div>

                <div class="alert alert-light border small mt-3 mb-0">
                    <div><i class="bi bi-shield-check text-gold"></i> 100% Secure</div>
                    <div class="mt-1"><i class="bi bi-truck text-gold"></i> Insured Delivery</div>
                    <div class="mt-1"><i class="bi bi-arrow-repeat text-gold"></i> 15-Day Returns</div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}