@{
    ViewData["Title"] = "About Us";
}

<!-- HERO -->
<section class="bg-cream py-5">
    <div class="container text-center py-4">
        <span class="badge bg-white text-gold border border-warning mb-3 px-3 py-2">
            ◆ Our Story
        </span>
        <h1 class="display-4 fw-bold" style="font-family: Georgia, serif;">
            Crafting Trust Since 1995
        </h1>
        <p class="text-muted fs-5 mx-auto" style="max-width: 700px;">
            India ka trusted multi-vendor jewellery marketplace — jaha har piece
            hallmarked hai, har seller verified hai, aur har customer khush hai.
        </p>
    </div>
</section>

<!-- STORY -->
<section class="py-5">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <img src="https://images.unsplash.com/photo-1611591437281-460bfbe1220a?w=800"
                     class="img-fluid rounded-4 shadow-lg" alt="Our Story" />
            </div>
            <div class="col-lg-6">
                <h2 class="fw-bold mb-4" style="font-family: Georgia, serif;">
                    Hamari Kahani
                </h2>
                <p class="text-muted">
                    Deepak Jewellers ki shuruaat 1995 me ek chhote se kaam se hui thi —
                    Mumbai ke ek gali me. Aaj hum India ke sabse trusted multi-vendor
                    jewellery marketplace me se ek hain.
                </p>
                <p class="text-muted">
                    Hamara sapna simple tha — har Indian ko bina tension ke,
                    bina bicholiye ke, asli certified jewellery dilana. Isiliye
                    humne vendors ko directly connect kiya aur har product ko
                    BIS Hallmark se certify karwaya.
                </p>
                <p class="text-muted mb-4">
                    Aaj 500+ verified sellers, 10,000+ happy customers aur
                    lakhs of jewellery pieces — ye sirf shuruat hai.
                </p>
                <div class="d-flex gap-3">
                    <a asp-controller="Shop" asp-action="Index" class="btn btn-gold px-4">
                        <i class="bi bi-bag"></i> Shop Now
                    </a>
                    <a asp-controller="Home" asp-action="Contact" class="btn btn-outline-gold px-4">
                        Contact Us
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- NUMBERS -->
<section class="py-5 bg-cream">
    <div class="container">
        <div class="row g-4 text-center">
            <div class="col-md-3 col-6">
                <i class="bi bi-shop text-gold" style="font-size: 2.5rem;"></i>
                <h2 class="fw-bold text-gold mt-3 mb-0">500+</h2>
                <p class="text-muted mb-0">Verified Sellers</p>
            </div>
            <div class="col-md-3 col-6">
                <i class="bi bi-people text-gold" style="font-size: 2.5rem;"></i>
                <h2 class="fw-bold text-gold mt-3 mb-0">10,000+</h2>
                <p class="text-muted mb-0">Happy Customers</p>
            </div>
            <div class="col-md-3 col-6">
                <i class="bi bi-gem text-gold" style="font-size: 2.5rem;"></i>
                <h2 class="fw-bold text-gold mt-3 mb-0">50,000+</h2>
                <p class="text-muted mb-0">Jewellery Pieces</p>
            </div>
            <div class="col-md-3 col-6">
                <i class="bi bi-star text-gold" style="font-size: 2.5rem;"></i>
                <h2 class="fw-bold text-gold mt-3 mb-0">4.8/5</h2>
                <p class="text-muted mb-0">Customer Rating</p>
            </div>
        </div>
    </div>
</section>

<!-- WHY CHOOSE US -->
<section class="py-5">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="fw-bold" style="font-family: Georgia, serif;">Why Choose Us?</h2>
            <div class="bg-gold mx-auto mt-2" style="width:60px;height:3px;"></div>
        </div>
        <div class="row g-4">
            <div class="col-lg-4 col-md-6">
                <div class="card border-0 shadow-sm h-100 p-4">
                    <div class="mb-3">
                        <i class="bi bi-patch-check text-gold" style="font-size: 2.5rem;"></i>
                    </div>
                    <h5 class="fw-bold" style="font-family: Georgia, serif;">100% Hallmarked</h5>
                    <p class="text-muted small mb-0">
                        Har product BIS Hallmarked hai. Gold, silver aur diamond —
                        sab certified aur verified.
                    </p>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="card border-0 shadow-sm h-100 p-4">
                    <div class="mb-3">
                        <i class="bi bi-shield-check text-gold" style="font-size: 2.5rem;"></i>
                    </div>
                    <h5 class="fw-bold" style="font-family: Georgia, serif;">Verified Sellers</h5>
                    <p class="text-muted small mb-0">
                        Har vendor KYC, GST aur physical verification se guzarta hai.
                        Fake seller ka koi chance nahi.
                    </p>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="card border-0 shadow-sm h-100 p-4">
                    <div class="mb-3">
                        <i class="bi bi-cash-coin text-gold" style="font-size: 2.5rem;"></i>
                    </div>
                    <h5 class="fw-bold" style="font-family: Georgia, serif;">Cash on Delivery</h5>
                    <p class="text-muted small mb-0">
                        Pura India me COD available. Product pasand aaye tabhi paise do.
                        Zero risk.
                    </p>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="card border-0 shadow-sm h-100 p-4">
                    <div class="mb-3">
                        <i class="bi bi-truck text-gold" style="font-size: 2.5rem;"></i>
                    </div>
                    <h5 class="fw-bold" style="font-family: Georgia, serif;">Insured Delivery</h5>
                    <p class="text-muted small mb-0">
                        Fully insured shipping. Loss ya damage pe 100% refund
                        guarantee.
                    </p>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="card border-0 shadow-sm h-100 p-4">
                    <div class="mb-3">
                        <i class="bi bi-arrow-repeat text-gold" style="font-size: 2.5rem;"></i>
                    </div>
                    <h5 class="fw-bold" style="font-family: Georgia, serif;">15-Day Returns</h5>
                    <p class="text-muted small mb-0">
                        Product pasand nahi aaya? 15 din me return karo.
                        No questions asked.
                    </p>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="card border-0 shadow-sm h-100 p-4">
                    <div class="mb-3">
                        <i class="bi bi-headset text-gold" style="font-size: 2.5rem;"></i>
                    </div>
                    <h5 class="fw-bold" style="font-family: Georgia, serif;">24/7 Support</h5>
                    <p class="text-muted small mb-0">
                        Hindi aur English me customer support.
                        Call, WhatsApp, ya email — jaisa aapko pasand.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

